{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "base", "name": "Fond", "color": "#f5f6f8" },
        { "slug": "surface", "name": "Surface", "color": "#ffffff" },
        { "slug": "contrast", "name": "Texte", "color": "#111827" },
        { "slug": "contrast-soft", "name": "Texte secondaire", "color": "#344054" },
        { "slug": "muted", "name": "Texte atténué", "color": "#7b8492" },
        { "slug": "border", "name": "Bordures", "color": "#e6e9ee" },
        { "slug": "sidebar", "name": "Navigation", "color": "#0f141b" },
        { "slug": "accent", "name": "Accent RC", "color": "#e85d2a" },
        { "slug": "accent-strong", "name": "Accent RC foncé", "color": "#d94f1f" },
        { "slug": "success", "name": "Succès", "color": "#147d64" },
        { "slug": "danger", "name": "Erreur", "color": "#b63c2d" }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1780px"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "rem", "%", "vw", "vh"]
    },
    "typography": {
      "customFontSize": true,
      "fluid": true,
      "lineHeight": true,
      "fontFamilies": [
        {
          "slug": "interface",
          "name": "Interface système",
          "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Petit", "size": "0.8125rem" },
        { "slug": "medium", "name": "Normal", "size": "0.9375rem" },
        { "slug": "large", "name": "Grand", "size": "1.125rem" },
        { "slug": "x-large", "name": "Très grand", "size": "1.75rem" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "spacing": {
      "blockGap": "1.25rem"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--interface)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.5"
    },
    "elements": {
      "heading": {
        "color": { "text": "var(--wp--preset--color--contrast)" },
        "typography": { "fontWeight": "700", "lineHeight": "1.15" }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--accent)" }
      },
      "button": {
        "border": { "radius": "10px" },
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--surface)"
        },
        "typography": { "fontWeight": "700" }
      }
    }
  }
}
